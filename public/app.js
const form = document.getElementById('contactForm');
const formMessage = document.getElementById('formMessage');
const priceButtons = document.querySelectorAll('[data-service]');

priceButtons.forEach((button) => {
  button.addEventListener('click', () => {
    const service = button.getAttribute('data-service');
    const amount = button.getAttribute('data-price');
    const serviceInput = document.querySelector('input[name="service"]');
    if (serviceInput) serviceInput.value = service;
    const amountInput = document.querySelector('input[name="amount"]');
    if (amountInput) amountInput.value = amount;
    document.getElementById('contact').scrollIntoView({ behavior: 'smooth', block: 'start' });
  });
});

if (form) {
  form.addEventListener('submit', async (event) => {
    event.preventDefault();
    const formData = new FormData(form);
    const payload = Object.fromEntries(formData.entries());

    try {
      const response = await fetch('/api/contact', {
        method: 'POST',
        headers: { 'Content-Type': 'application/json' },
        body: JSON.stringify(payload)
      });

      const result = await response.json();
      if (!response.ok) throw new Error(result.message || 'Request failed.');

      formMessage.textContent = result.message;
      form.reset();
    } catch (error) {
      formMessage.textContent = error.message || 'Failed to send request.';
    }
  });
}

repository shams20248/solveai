* {
  box-sizing: border-box;
}

:root {
  --bg: #06131f;
  --bg-2: #0b1c2b;
  --panel: rgba(18, 35, 47, 0.8);
  --text: #eaf5ff;
  --muted: #aec6d8;
  --primary: #5fd1ff;
  --accent: #8ef0c7;
  --border: rgba(255, 255, 255, 0.08);
  --card: #10283b;
  --shadow: 0 20px 60px rgba(1, 8, 14, 0.45);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: linear-gradient(180deg, var(--bg) 0%, #081b2a 40%, #0b1d2c 100%);
  color: var(--text);
  font-family: 'Inter', sans-serif;
}

a { text-decoration: none; color: inherit; }
button, input, textarea { font: inherit; }

.container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(12px);
  background: rgba(6, 19, 31, 0.7);
  border-bottom: 1px solid var(--border);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #06212d;
  font-weight: 900;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  color: var(--muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  border: none;
  border-radius: 12px;
  padding: 0 22px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.btn:hover { transform: translateY(-1px); }

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #032437;
  box-shadow: 0 12px 30px rgba(95, 209, 255, 0.25);
}

.btn-secondary {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--border);
}

.hero { padding: 72px 0 40px; }
.hero-grid {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 30px;
  align-items: center;
}

.hero-copy h1 {
  font-size: clamp(2.6rem, 5vw, 4.5rem);
  line-height: 1.1;
  margin: 16px 0 20px;
  letter-spacing: -0.05em;
}

.eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
}

.hero-copy p {
  color: var(--muted);
  font-size: 1.08rem;
  line-height: 1.8;
  max-width: 620px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin: 26px 0 30px;
}

.hero-stats {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
}

.hero-stats li {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 120px;
}

.hero-stats strong { font-size: 1.5rem; }
.hero-stats span { color: var(--muted); font-size: 0.84rem; }

.hero-panel { display: flex; justify-content: center; }
.panel-card {
  width: min(100%, 420px);
  background: linear-gradient(180deg, rgba(19, 39, 52, 0.95), rgba(12, 22, 30, 0.92));
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 26px;
  box-shadow: var(--shadow);
}

.card-label {
  color: var(--accent);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 18px;
}

.mini-metric {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}

.mini-metric span { color: var(--muted); }
.mini-metric strong { font-size: 1.25rem; }

.status-pod {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
  font-size: 0.95rem;
  color: var(--muted);
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 18px rgba(142, 240, 199, 0.9);
}

.logo-strip {
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.015);
}

.center { text-align: center; }
.logo-strip p {
  color: var(--muted);
  margin: 0;
  padding: 18px 0;
}

.section { padding: 88px 0; }
.alt { background: rgba(255, 255, 255, 0.015); }

.section-heading {
  text-align: center;
  margin-bottom: 40px;
}

.section-heading.left { text-align: left; }
.section-heading h2 {
  font-size: clamp(2rem, 3vw, 3rem);
  margin: 12px 0 0;
}

.cards { display: grid; gap: 22px; }
.three-up { grid-template-columns: repeat(3, minmax(0, 1fr)); }

.service-card, .price-card, .step-box, .contact-card, .contact-form {
  background: linear-gradient(180deg, rgba(16, 40, 59, 0.96), rgba(12, 24, 34, 0.94));
  border: 1px solid var(--border);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.service-card, .price-card, .step-box { padding: 28px 24px; }

.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: rgba(95, 209, 255, 0.1);
  color: var(--primary);
  font-weight: 800;
  margin-bottom: 20px;
}

.service-card h3, .price-card h3, .step-box h3 {
  margin: 0 0 12px;
  font-size: 1.4rem;
}

.service-card p, .step-box p, .contact-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.step-box span {
  display: inline-flex;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
  background: rgba(142, 240, 199, 0.12);
  color: var(--accent);
  font-weight: 800;
  margin-bottom: 18px;
}

.price-card { position: relative; padding-top: 30px; }
.price-card.featured {
  border-color: rgba(95, 209, 255, 0.8);
  transform: translateY(-8px);
}

.featured-badge {
  position: absolute;
  top: 18px;
  right: 20px;
  background: rgba(95, 209, 255, 0.14);
  color: var(--primary);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.7rem;
  font-weight: 700;
}

.price {
  font-size: 2.2rem;
  font-weight: 800;
  margin: 18px 0 16px;
}

.price span {
  font-size: 0.9rem;
  color: var(--muted);
  margin-left: 6px;
}

.price-card ul {
  list-style: none;
  margin: 0 0 24px;
  padding: 0;
  color: var(--muted);
  line-height: 2;
}

.form-section { padding-bottom: 110px; }
.split-layout {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 28px;
  align-items: start;
}

.contact-card {
  padding: 22px 20px;
  margin-top: 16px;
}

.contact-form {
  padding: 28px;
  display: grid;
  gap: 18px;
}

.contact-form label {
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-weight: 600;
}

.contact-form input, .contact-form textarea {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(8, 18, 29, 0.9);
  color: var(--text);
  padding: 14px 16px;
  resize: vertical;
}

.contact-form input:focus, .contact-form textarea:focus {
  outline: 2px solid rgba(95, 209, 255, 0.35);
  border-color: rgba(95, 209, 255, 0.5);
}

.full-width { width: 100%; }
.form-message {
  min-height: 18px;
  color: var(--accent);
  font-weight: 600;
}

.site-footer {
  border-top: 1px solid var(--border);
  padding: 26px 0 44px;
}

.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.footer-brand { font-size: 1.1rem; }
.footer-links {
  display: flex;
  gap: 18px;
  color: var(--muted);
}

@media (max-width: 900px) {
  .hero-grid, .split-layout, .three-up, .steps-grid { grid-template-columns: 1fr; }
  .nav {
    flex-wrap: wrap;
    justify-content: center;
    padding: 16px 0;
    gap: 14px;
  }
  .nav-links { flex-wrap: wrap; justify-content: center; }
}

@media (max-width: 640px) {
  .hero { padding-top: 48px; }
  .hero-copy h1 { font-size: 2.7rem; }
  .hero-actions { flex-direction: column; }
  .btn { width: 100%; }
  .footer-row { flex-direction: column; text-align: center; }
}
